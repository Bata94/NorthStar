{
  "title": "northstar DNS Server",
  "tags": ["dns", "northstar"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "title": "Query Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(northstar_dns_queries_total[5m])",
          "legendFormat": "queries/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(northstar_cache_hits_total[5m]) / rate(northstar_cache_lookups_total[5m]) * 100",
          "legendFormat": "hit ratio %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "showPoints": "never" }, "min": 0, "max": 100 }
      }
    },
    {
      "title": "Negative Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(northstar_cache_negative_hits_total[5m]) / rate(northstar_cache_negative_lookups_total[5m]) * 100",
          "legendFormat": "negative hit ratio %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "showPoints": "never" }, "min": 0, "max": 100 }
      }
    },
    {
      "title": "Cache Evictions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(northstar_cache_evictions_total[5m])",
          "legendFormat": "{{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Upstream Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(northstar_upstream_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(northstar_upstream_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(northstar_upstream_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Upstream Health",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "northstar_upstream_healthy",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "showPoints": "never" }, "min": 0, "max": 1 }
      }
    },
    {
      "title": "Error Rate by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(northstar_dns_errors_total[5m])",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Active Handlers",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "northstar_dns_active_handlers",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Blocked Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(northstar_filter_blocked_total[5m])",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "showPoints": "never" } }
      }
    },
    {
      "title": "Upstream Queries per Upstream",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "rate(northstar_upstream_queries_total[5m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "qps", "custom": { "showPoints": "never" } }
      }
    }
  ]
}
